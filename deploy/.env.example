# Copy to deploy/.env and fill in. .env is gitignored.

# Database. The password has no default on purpose -- compose refuses to start
# without it rather than falling back to something guessable.
POSTGRES_DB=fishclaim
POSTGRES_USER=fishclaim
POSTGRES_PASSWORD=

# JWT signing key. Generate your own; the API validates this at startup and
# will not boot on a blank, short or placeholder value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# How long a claim survives without a refresh.
CLAIM_LIFETIME_DAYS=30

# Published ports on the host.
BACKEND_PORT=8080
FRONTEND_PORT=8081
DB_PORT=5432

# Allowed browser origins for the API. Behind the bundled nginx the SPA and the
# API share an origin, so this only needs widening for a separate dev server.
CORS_ORIGINS=http://localhost:8081
