# Copy to .env.local and fill in. .env.local is gitignored.
#
# Every VITE_* value is inlined into the bundle at BUILD time, not read at
# runtime -- anyone who opens devtools can read it. Never put a secret here.

# Backend API base. Leave as /api when running behind the bundled nginx, which
# is what deploy/docker-compose.yml does. Point it straight at the API when
# running the Vite dev server on its own.
VITE_API_BASE_URL=http://localhost:8080/api

# Map geometry paths, appended to VITE_API_BASE_URL. Both currently return
# empty GeoJSON -- there is no geometry layer yet.
VITE_RIVERS_BBOX_PATH=/rivers
VITE_CLAIMS_BBOX_PATH=/claims
