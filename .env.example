# Copy to .env.local and fill in. .env.local is gitignored.
#
# Every VITE_* value is inlined into the bundle at BUILD time, not read at
# runtime -- anyone who opens devtools can read it. Never put a secret here.

# Backend API base. Leave as /api when running behind the nginx proxy, which
# is what the Docker image does. In local dev point it straight at the backend.
VITE_API_BASE_URL=http://localhost:8080/api

# Map geometry paths, appended to VITE_API_BASE_URL. Both currently return
# empty GeoJSON -- see "Map data is still a placeholder" in the README.
VITE_RIVERS_BBOX_PATH=/rivers
VITE_CLAIMS_BBOX_PATH=/claims
