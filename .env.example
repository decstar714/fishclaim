# Database connection string (Postgres/PostGIS)
# For Docker compose: postgresql+psycopg2://fishclaim:fishclaim@fishclaim-db:5432/fishclaim
# For host/local:    postgresql+psycopg2://user:password@localhost:5432/fishclaim
DATABASE_URL=postgresql+psycopg2://fishclaim:fishclaim@localhost:5432/fishclaim

# JWT signing secret (set to a strong random value in real envs)
SECRET_KEY=change-me

# JWT algorithm and token lifetime (minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (frontend dev servers, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
