# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fishclaim

# Auth
# Generate your own -- the app refuses to start on a placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CLAIM_LIFETIME_DAYS=30

# Seed user (used by python -m app.seed)
SEED_USER_EMAIL=owner@example.com
SEED_USER_USERNAME=owner
SEED_USER_DISPLAY_NAME=FishClaim Owner
SEED_USER_PASSWORD=
SEED_FORCE_RESET=true

# API
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
