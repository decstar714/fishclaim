#!/usr/bin/env bash
#
# Block commits that contain credential-shaped strings.
#
# This repo has already leaked a Shopify Admin token once -- it is still in the
# history and cannot be removed, only rotated. This hook exists so it does not
# happen a second time.
#
# Install:
#   ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
#
# Bypass, if you are certain a match is a false positive:
#   git commit --no-verify
#
set -uo pipefail

# Only look at what is actually STAGED, and only at added lines.
staged_added() {
  git diff --cached --no-color -U0 -- . | grep -aE '^\+' | grep -av '^+++'
}

# pattern::human description
PATTERNS=(
  'shpat_[A-Za-z0-9]{20,}::Shopify Admin API token'
  'shpss_[A-Za-z0-9]{20,}::Shopify shared secret'
  'shpca_[A-Za-z0-9]{20,}::Shopify custom app token'
  'sk-[A-Za-z0-9]{32,}::OpenAI-style secret key'
  'sk-ant-[A-Za-z0-9_-]{20,}::Anthropic API key'
  'AKIA[0-9A-Z]{16}[^0-9A-Z]::AWS access key ID'
  'ghp_[A-Za-z0-9]{36}::GitHub personal access token'
  'github_pat_[A-Za-z0-9_]{20,}::GitHub fine-grained PAT'
  'xox[baprs]-[0-9]{10,}-[0-9]{10,}-[A-Za-z0-9]{20,}::Slack token'
  'sq0(atp|csp|idp)-[A-Za-z0-9_-]{20,}::Square token'
  '[-]{5}BEGIN (RSA|EC|OPENSSH|DSA|PGP)? ?PRIVATE KEY::private key block'
  'postgres(ql)?://[^:/@[:space:]]+:[^@[:space:]]{6,}@::database URL with password'
)

# Credentials with no distinctive shape (brokerage, bot and vendor API keys) can
# only be caught by the NAME they are assigned to. Placeholder values -- the
# your_x_here / <value> / changeme style used in .env.example files -- are
# deliberately excluded so committing a template never trips the hook.
NAMED='(SCHWAB|TELEGRAM|POLYGON|ANTHROPIC|OPENAI|SHOPIFY|SQUARE|FINNHUB|TRADIER|QUIVER|BENZINGA|ALPHA_VANTAGE|SMTP)_[A-Z_]*(TOKEN|SECRET|KEY|PASSWORD)[[:space:]]*[=:][[:space:]]*.?[A-Za-z0-9_/+-]{16,}'
PLACEHOLDER='(your_|_here|<|example|changeme|xxxx|placeholder|REPLACE|\.\.\.)'

added="$(staged_added || true)"
[ -z "$added" ] && exit 0

found=0
for entry in "${PATTERNS[@]}"; do
  pat="${entry%%::*}"
  desc="${entry##*::}"
  if hits="$(printf '%s\n' "$added" | grep -aEc -- "$pat")" && [ "${hits:-0}" -gt 0 ]; then
    if [ "$found" -eq 0 ]; then
      echo
      echo "  COMMIT BLOCKED -- credential-shaped content is staged"
      echo
      found=1
    fi
    printf '    %-34s %s staged line(s)\n' "$desc" "$hits"
    # show which files, never the matching value
    git diff --cached --name-only -- . | while read -r f; do
      [ -f "$f" ] || continue
      if git diff --cached -U0 -- "$f" | grep -aE '^\+' | grep -av '^+++' \
         | grep -aqE -- "$pat"; then
        printf '        %s\n' "$f"
      fi
    done
  fi
done

# name-based pass, excluding obvious placeholders
named_hits="$(printf '%s\n' "$added" | grep -aE -- "$NAMED" | grep -avEi -- "$PLACEHOLDER" | wc -l)"
if [ "${named_hits:-0}" -gt 0 ]; then
  if [ "$found" -eq 0 ]; then
    echo
    echo "  COMMIT BLOCKED -- credential-shaped content is staged"
    echo
    found=1
  fi
  printf '    %-34s %s staged line(s)\n' "secret-named assignment" "$named_hits"
fi

if [ "$found" -eq 1 ]; then
  cat <<'EOF'

  Move the value to an environment variable and read it at runtime:

      import os
      TOKEN = os.environ.get("SHOPIFY_TOKEN")
      if not TOKEN:
          raise SystemExit("SHOPIFY_TOKEN is not set")

  If this is genuinely a false positive:  git commit --no-verify

EOF
  exit 1
fi

exit 0
